generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  passwordHash        String
  preferredCurrency   String               @default("USD")
  travelPreferences   Json?
  notificationPrefs   Json?
  avatarUrl           String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  trips               Trip[]
  expenses            Expense[]
  favorites           Favorite[]
  passwordResetTokens PasswordResetToken[]
  tripNotes           TripNote[]
}

model Trip {
  id             String         @id @default(uuid())
  userId         String
  title          String
  description    String?
  startLocation  String
  destinations   String[]
  startDate      DateTime?
  endDate        DateTime?
  numTravelers   Int            @default(1)
  budget         Float?
  currency       String         @default("USD")
  travelStyle    String?
  status         String         @default("planning") // planning | active | completed | cancelled
  isPublic       Boolean        @default(false)
  coverImageUrl  String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryDays  ItineraryDay[]
  expenses       Expense[]
  graphNodes     GraphNode[]
  graphEdges     GraphEdge[]
  sharedTrips    SharedTrip[]
  tripNotes      TripNote[]

  @@index([userId])
  @@index([status])
}

model Destination {
  id                    String        @id @default(uuid())
  name                  String
  country               String
  city                  String?
  description           String?
  imageUrl              String?
  latitude              Float?
  longitude             Float?
  estimatedBudgetPerDay Float?
  currency              String        @default("USD")
  category              String?
  tags                  String[]
  isPopular             Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  attractions           Attraction[]
  favorites             Favorite[]
}

model Attraction {
  id                     String      @id @default(uuid())
  destinationId          String
  name                   String
  description            String?
  imageUrl               String?
  latitude               Float?
  longitude              Float?
  category               String?
  estimatedCost          Float?
  currency               String      @default("USD")
  estimatedDurationHours Float?
  openingHours           String?
  rating                 Float?
  createdAt              DateTime    @default(now())
  destination            Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model ItineraryDay {
  id          String     @id @default(uuid())
  tripId      String
  dayNumber   Int
  date        DateTime?
  location    String?
  summary     String?
  weatherNote String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities  Activity[]

  @@index([tripId])
}

model Activity {
  id             String       @id @default(uuid())
  itineraryDayId String
  name           String
  description    String?
  location       String?
  latitude       Float?
  longitude      Float?
  timeOfDay      String? // morning | afternoon | evening | night
  startTime      String?
  endTime        String?
  estimatedCost  Float?
  currency       String       @default("USD")
  category       String?
  notes          String?
  isCompleted    Boolean      @default(false)
  orderIndex     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId])
}

model GraphNode {
  id          String      @id @default(uuid())
  tripId      String?
  name        String
  nodeType    String // city | destination | attraction | hotel | restaurant | airport | railway | bus | nature
  latitude    Float?
  longitude   Float?
  description String?
  imageUrl    String?
  metadata    Json?
  positionX   Float?
  positionY   Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  trip        Trip?       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  edgesFrom   GraphEdge[] @relation("EdgeSource")
  edgesTo     GraphEdge[] @relation("EdgeTarget")

  @@index([tripId])
  @@index([nodeType])
}

model GraphEdge {
  id            String    @id @default(uuid())
  tripId        String?
  sourceId      String
  targetId      String
  edgeType      String // road | railway | flight | walking | nearby | recommended
  distance      Float? // km
  duration      Float? // minutes
  transportMode String?
  estimatedCost Float?
  currency      String    @default("USD")
  weight        Float?
  isDirected    Boolean   @default(false)
  metadata      Json?
  createdAt     DateTime  @default(now())
  trip          Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  source        GraphNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target        GraphNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([sourceId])
  @@index([targetId])
}

model Expense {
  id          String    @id @default(uuid())
  tripId      String
  userId      String
  category    String // transportation | accommodation | food | activities | shopping | miscellaneous
  title       String
  description String?
  amount      Float
  currency    String    @default("USD")
  date        DateTime?
  isEstimated Boolean   @default(false)
  receiptUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@index([category])
}

model Favorite {
  id            String      @id @default(uuid())
  userId        String
  destinationId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
}

model TripNote {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model SharedTrip {
  id        String    @id @default(uuid())
  tripId    String
  token     String    @unique @default(uuid())
  isPublic  Boolean   @default(true)
  allowEdit Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}
